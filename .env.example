# Copy this file to .env and fill in real local values:   cp .env.example .env
# .env is gitignored - NEVER commit real secrets. Every value below is a
# placeholder; generate your own where a command is shown.

# --- Postgres ---
POSTGRES_USER=retaillake
POSTGRES_PASSWORD=changeme
POSTGRES_DB=retaildb

# --- MinIO ---
MINIO_ROOT_USER=retaillake
MINIO_ROOT_PASSWORD=changeme123
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE=http://localhost:9001

# --- Airflow ---
# Generate a real Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

# --- Superset ---
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=replace-with-generated-secret-key

# --- PII hashing (Silver layer) ---
# Secret salt mixed into the SHA-256 of emails/phones so the hashes cannot be
# reversed with a table of common emails. Generate with the same command as
# above. Leave empty for a plain SHA-256 (fine for a demo, not for production).
# Changing it changes every hash, so pick one value and keep it.
PII_HASH_SALT=replace-with-generated-salt

# --- Mock data generator ---
SEED_RANDOM_SEED=42
